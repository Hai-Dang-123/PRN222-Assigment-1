@page
@model GroupBoizMVC.RazorPage.Register.IndexModel
@using GroupBoizCommon.DTO

@{
    Layout = "/RazorPage/Shared/_MinimalLayout.cshtml";
    ViewData["Title"] = "Register";

}

<link rel="stylesheet" href="~/assets/css/sign-In-Up.css" />
<script src="~/vendor/jquery/jquery.min.js"></script>

<!-- Sign up form -->
<section class="signup">
    <div class="container">
        <div class="signup-content">
            <div class="signup-form">
                <h2 class="form-title">Sign up</h2>

                <!-- Hiển thị thông báo thành công -->
                @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
                {
                    <div class="alert alert-success mt-2">@TempData["SuccessMessage"]</div>
                }

                <!-- Hiển thị lỗi tổng quát -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mt-2">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form method="POST" class="register-form" id="register-form">
                    <div class="form-group">
                        <label for="AccountName"><i class="zmdi zmdi-account material-icons-name"></i></label>
                        <input asp-for="Register.AccountName" class="form-control" placeholder="Your Name" />
                        <span asp-validation-for="Register.AccountName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="AccountEmail"><i class="zmdi zmdi-email"></i></label>
                        <input asp-for="Register.AccountEmail" class="form-control" placeholder="Your Email" />
                        <span asp-validation-for="Register.AccountEmail" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="AccountPassword"><i class="zmdi zmdi-lock"></i></label>
                        <input asp-for="Register.AccountPassword" type="password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Register.AccountPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="ConfirmPassword"><i class="zmdi zmdi-lock-outline"></i></label>
                        <input asp-for="Register.ConfirmPassword" type="password" class="form-control" placeholder="Repeat your password" />
                        <span asp-validation-for="Register.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group form-button">
                        <input type="submit" name="signup" id="signup" class="form-submit" value="Register" />
                    </div>
                </form>
            </div>
            <div class="signup-image">
                <figure><img src="~/assets/images/signup-image.jpg" alt="sign up image" /></figure>
                <a href="/Login/Index" class="signup-image-link">I am already a member</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
