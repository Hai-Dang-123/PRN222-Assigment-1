@using GroupBoizCommon.DTO
@model RegisterDTO

@{
    ViewData["Title"] = "Register";
    Layout = "_MinimalLayout";
}

<link rel="stylesheet" href="~/assets/css/sign-In-Up.css" />
<script src="~/vendor/jquery/jquery.min.js"></script>

<!-- Sign up form -->
<section class="signup">
    <div class="container">
        <div class="signup-content">
            <div class="signup-form">
                <h2 class="form-title">Sign up</h2>

                <!-- Hiển thị lỗi tổng quát -->
                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="alert alert-danger mt-2">@ViewBag.ErrorMessage</div>
                }

                <form asp-action="Index" asp-controller="Register" method="POST" class="register-form" id="register-form">
                    <div class="form-group">
                        <label for="AccountName"><i class="zmdi zmdi-account material-icons-name"></i></label>
                        <input asp-for="AccountName" class="form-control" placeholder="Your Name" />
                        <span asp-validation-for="AccountName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="AccountEmail"><i class="zmdi zmdi-email"></i></label>
                        <input asp-for="AccountEmail" class="form-control" placeholder="Your Email" />
                        <span asp-validation-for="AccountEmail" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="AccountPassword"><i class="zmdi zmdi-lock"></i></label>
                        <input asp-for="AccountPassword" type="password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="AccountPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="ConfirmPassword"><i class="zmdi zmdi-lock-outline"></i></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                   

                    <div class="form-group form-button">
                        <input type="submit" name="signup" id="signup" class="form-submit" value="Register" />
                    </div>
                </form>
            </div>
            <div class="signup-image">
                <figure><img src="~/assets/images/signup-image.jpg" alt="sign up image" /></figure>
                <a href="/Account/Login" class="signup-image-link">I am already a member</a>
            </div>
        </div>
    </div>
</section>

